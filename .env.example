# Copy this file to .env and fill in your values. .env is gitignored.

# --- LLM (Gemini API, free tier) ---
# Get a key at https://aistudio.google.com (do NOT link a billing account).
GEMINI_API_KEY=
# Copy the exact free-tier Flash model ID from AI Studio. IDs change often.
GEMINI_MODEL=

# --- Database (PostgreSQL + pgvector running in WSL) ---
DATABASE_URL=postgresql+psycopg://hanrag:hanrag_dev@localhost:5432/hanrag

# --- Models (CPU, ONNX via fastembed) ---
# onnx-int8 (default, bge-m3 quantized, ~570 MB) | fastembed (fp32 BAAI/bge-m3, ~2.3 GB)
# | sentence-transformers (fallback: uv sync --extra st). Changing it needs: scripts.reembed
EMBED_BACKEND=onnx-int8
EMBED_MODEL=gpahal/bge-m3-onnx-int8
EMBED_DIM=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
MODEL_CACHE_DIR=D:/dev-cache/models
ONNX_THREADS=4
RERANK_BATCH_SIZE=2
RERANK_MAX_CHARS=600

# --- Retrieval ---
TOP_K_BM25=30
TOP_K_VECTOR=30
TOP_K_RERANK=12
TOP_K_FINAL=5
RRF_K=60
# vector | bm25 | hybrid | hybrid_rerank   and   kiwi | whitespace
RETRIEVAL_MODE=hybrid_rerank
BM25_TOKENIZER=kiwi
# Refuse without calling the LLM when the best passage scores below these
MIN_VECTOR_SCORE=0.35
MIN_RERANK_SCORE=0.05
# Rewrite follow-ups + translate ko<->en for BM25 (1 extra LLM call per question)
QUERY_REWRITE=true

# --- App ---
DATA_DIR=./data
LOG_LEVEL=INFO
RATE_LIMIT=20/minute
CORS_ORIGINS=http://localhost:3000
